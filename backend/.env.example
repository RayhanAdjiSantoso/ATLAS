PORT=5001
DATABASE_URL=postgresql://rayhanadjisantoso@localhost:5432/atlas_FIN
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Web app harus di-deploy dengan "Who has access: Anyone" (URL bentuk
# https://script.google.com/macros/s/<ID>/exec, bukan /a/macros/<domain>/s/...)
META_AUTOMATION_WEBAPP_URL=
META_AUTOMATION_API_KEY=
# AI Summary (Report Generator) — Google AI Studio key
GEMINI_API_KEY=
# Opsional. Default 'gemini-flash-latest'. Free tier dibatasi 20 request per
# HARI per model, dan tiap model punya jatah sendiri — kalau satu model habis,
# ganti ke model lain di sini (mis. gemini-3.5-flash) tanpa mengubah kode.
GEMINI_MODEL=
# Daily Tracking — kunci rahasia yang dikirim balik oleh Apps Script
# (DailyTrackingBoostPost.gs, run terjadwal 01:00 WIB) saat memanggil
# POST /api/daily-tracking/ingest untuk auto-isi spend Meta Boost/Non-Boost.
# Simpan nilai yang sama di Script Properties Apps Script sebagai ATLAS_INGEST_KEY.
DAILY_TRACKING_INGEST_API_KEY=
# Google Reviews Analytics — sumber data.
#   playwright = EKSPERIMEN, hanya development lokal: Chrome membuka Google Maps
#   publik dan membaca ulasan yang terlihat tanpa login (±5 per bisnis). Tidak
#   login, tidak melewati CAPTCHA. Jangan diset di Vercel.
# Kosong = belum ada sumber; halaman menampilkan pemberitahuan.
GOOGLE_REVIEWS_PROVIDER=
# Opsional untuk playwright: 'chrome' memakai Google Chrome yang terpasang
# (tanpa itu: npx playwright install chromium). Headless tidak mendapat ulasan
# saat diuji, jadi default-nya jendela biasa (false).
GR_PLAYWRIGHT_CHANNEL=
GR_PLAYWRIGHT_HEADLESS=false
GR_PLAYWRIGHT_MAX_REVIEWS=500
GR_PLAYWRIGHT_TIMEOUT_MS=60000
GR_PLAYWRIGHT_MIN_INTERVAL_MS=5000
GR_PLAYWRIGHT_RETENTION_DAYS=30
# Login Google untuk sumber playwright (opsional): jalankan
#   npm run google-reviews:login
# lalu login sendiri di jendela Chrome yang terbuka. Sesinya disimpan di folder
# ini (di luar repo). Siapa pun yang memegang folder ini memegang sesi akun itu.
GR_PLAYWRIGHT_PROFILE_DIR=
GR_PLAYWRIGHT_PAGE_MS=20000
# Bahasa antarmuka Google Maps. Google hanya memberi tombol "Lainnya" pada ulasan
# berbahasa sama dengan antarmuka; id cocok untuk bisnis di Indonesia.
GR_PLAYWRIGHT_LANG=id
# Google Reviews — Import CSV (V1). Batas file dan masa simpan ulasan hasil import
# (konten Google Maps; 0 = tanpa batas waktu).
GR_CSV_MAX_BYTES=4194304
GR_CSV_MAX_ROWS=10000
GR_CSV_RETENTION_DAYS=30
