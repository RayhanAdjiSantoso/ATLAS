# Dependencies
node_modules/

# Environment secrets (backend/.env, backend/standalone/.env — never commit).
# Pola .env saja hanya cocok dengan file bernama persis itu; varian seperti
# .env.production (mis. hasil `vercel env pull`) lolos dan ikut ter-commit.
# .env.example sengaja dikecualikan karena isinya memang template kosong.
.env
.env.*
!.env.example

# Build output
dist/

# Runtime data — user-uploaded Excel files, generated at runtime, not source
/backend/uploads/

# migrateClientInfo.js review-artifact CSVs — regenerable, not source
/backend/scripts/out/

# OS/editor cruft
.DS_Store

# Impeccable — local design tooling, not app code. 14MB of skill + a native
# binary, reinstalled rather than committed:
#   npx impeccable install -y --providers=claude --scope=project
.claude/skills/impeccable/
.claude/agents/impeccable-*
.claude/settings.local.json
# Per-run scratch. DESIGN.md, .impeccable/design.json and .impeccable/surfaces/
# are the durable outputs and DO belong in the repo.
.impeccable/critique/
.impeccable/review/
.impeccable/questions/
.impeccable/hook.cache.json

# Local UI/UX skill pack (ui-ux-pro-max) — reference data, not app code.
frontend/.claude/skills/
